# ABOUTME: Example environment variables for n8n Docker Compose setup.
# ABOUTME: Copy to .env and fill in real values before running.

GENERIC_TIMEZONE=Europe/Paris
N8N_HOST=n8n.develle.fr
N8N_EDITOR_BASE_URL=https://n8n.develle.fr/
WEBHOOK_URL=https://n8n.develle.fr/

# --- Cloudflare Tunnel ---
# Create a tunnel in Cloudflare Zero Trust dashboard → Networks → Tunnels
# and paste the token here. The cloudflared container uses this to connect.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# --- Security notes ---
# The following are set directly in docker-compose.yml (not here) because
# they are fixed security policy, not per-deployment config:
#
# NODES_EXCLUDE          — blocks Execute Command, Read/Write File, SSH, Git,
#                          Local File Trigger to prevent shell access and
#                          arbitrary file I/O from student workflows.
# N8N_BLOCK_ENV_ACCESS_IN_NODE       — prevents workflows from reading env vars.
# N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES — prevents access to n8n config/DB files.
# N8N_RESTRICT_FILE_ACCESS_TO=/files — limits file ops to the ./shared volume.
# N8N_COMMUNITY_PACKAGES_ENABLED     — disabled; students cannot install packages.
# NODE_FUNCTION_ALLOW_BUILTIN        — empty; Code node cannot require() builtins.
# NODE_FUNCTION_ALLOW_EXTERNAL       — empty; Code node cannot import npm packages.
