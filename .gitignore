# ABOUTME: Git ignore rules for the Markdowns2Teach project.
# ABOUTME: Excludes build artifacts, dependencies, and generated presentations.

# Build output
dist/

# Generated infographics (PaperBanana workspace)
infographics/
outputs/

# PaperBanana vendored clone and run archive
paperbanana/PaperBanana/
paperbanana/runs/
r&d/

# Private archive — PII, credentials, student work, exam data
.private/

# Teacher-only n8n workflows (not distributed to students)
n8n/workflows/not_given/

# Safety net for legacy PII paths (in case they reappear at old locations)
/students.csv
/N8N Groupes Projects - group-roster.csv
/Master 2 IMTE 2025-2026.pdf
/student_submissions/
/transcript*.vtt
/n8n/backups/
/n8n/group-credentials.csv
/docs/qcm/exam/

# Node
node_modules/

# Binary assets (images extracted from PDFs — too large for git)
slides/**/assets/**/*.png
slides/**/assets/**/*.jpg
slides/**/assets/**/*.gif

# Source materials (large binary files — PDFs, notebooks, HTML archives)
docs/sources/
!docs/sources/**/README.md

# Archive files
*.zip

# Secrets
.envrc
n8n/.env
n8n/group-credentials.csv

# n8n runtime data
n8n/shared/

# OS files
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
