# ABOUTME: Git ignore rules for the Markdowns2Teach project.
# ABOUTME: Excludes build artifacts, dependencies, and generated presentations.

# Build output
dist/

# Generated infographics (PaperBanana workspace)
infographics/
outputs/

# PaperBanana — tracked as its own repo (github.com:ezalos/PaperBanana_as_skill)
paperbanana/
r&d/

# Private archive — PII, credentials, student work, exam data
.private/

# Teacher-only n8n workflows (not distributed to students)
workshops/sorbonne-m2-n8n/workflows/not_given/

# Safety net for legacy PII paths (in case they reappear at old locations)
/students.csv
/N8N Groupes Projects - group-roster.csv
/Master 2 IMTE 2025-2026.pdf
/student_submissions/
/transcript*.vtt
/workshops/sorbonne-m2-n8n/backups/
/workshops/sorbonne-m2-n8n/group-credentials.csv
/docs/courses/sorbonne-m2/qcm/exam/

# Node
node_modules/

# Binary assets (images extracted from PDFs — too large for git)
slides/**/assets/**/*.png
slides/**/assets/**/*.jpg
slides/**/assets/**/*.jpeg
slides/**/assets/**/*.gif
slides/**/assets/**/*.svg
slides/**/assets/**/*.webp

# Source materials (large binary files — PDFs, notebooks, HTML archives)
# Ignore everything under sources/ except README.md at any depth. The directory
# re-include (!**/) is required so git descends far enough for the README negation.
docs/courses/sorbonne-m2/sources/**
!docs/courses/sorbonne-m2/sources/**/
!docs/courses/sorbonne-m2/sources/**/README.md

# Archive files
*.zip

# Secrets
.envrc
workshops/sorbonne-m2-n8n/.env
workshops/sorbonne-m2-n8n/group-credentials.csv

# n8n runtime data
workshops/sorbonne-m2-n8n/shared/

# OS files
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/

# Per-run citation audit bundles (kept local, not versioned)
docs/citation-audit/
